# ─────────────────────────────────────────────────────────────
# Nomora — Variables de entorno de ejemplo
# Copiar a .env y rellenar con valores reales
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL="postgresql://nomora_user:nomora_pass@localhost:5432/nomora_db"

# Redis
REDIS_URL="redis://:nomora_redis_pass@localhost:6379/0"

# NextAuth (Next.js)
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Origen del backend para el proxy server-side de Next.js (apps/web route handler).
# No exponer al navegador con NEXT_PUBLIC_*.
BACKEND_API_ORIGIN="http://127.0.0.1:8000/api/v1"

# Stripe — se configuran en el entorno del backend, nunca en NEXT_PUBLIC_*
# El precio debe ser un Price recurrente de Stripe (price_...).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BILLING_PORTAL_RETURN_URL="http://localhost:3000/plans"

# Beds24 API V2 — token de refresh con alcance read:bookings y read:properties.
# Se conserva únicamente en el entorno del backend.
BEDS24_REFRESH_TOKEN=""
