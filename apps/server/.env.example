# ─────────────────────────────────────────────────────────────
# Nomora Server — Variables de entorno de ejemplo
# Copiar a .env y completar antes de arrancar el servidor
# ─────────────────────────────────────────────────────────────

APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# PostgreSQL (debe coincidir con docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://nomora_user:nomora_pass@localhost:5432/nomora_db

# Redis (debe coincidir con docker-compose.yml)
REDIS_URL=redis://:nomora_redis_pass@localhost:6379/0

# CORS — orígenes permitidos (producción + desarrollo)
CORS_ORIGINS=["http://localhost:3000","https://nomoraweb.vercel.app"]

# CORS Regex — para preview deployments dinámicos de Vercel
# Cubre: nomoraweb.vercel.app, nomoraweb-git-branch-user.vercel.app, etc.
CORS_ORIGIN_REGEX=https://nomoraweb.*\.vercel\.app
